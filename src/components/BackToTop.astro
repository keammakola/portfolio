---
import { siteConfig } from "../config";
---

<button
  id="back-to-top"
  class="fixed bottom-6 right-6 sm:bottom-8 sm:right-8 z-50 p-3 sm:p-4 rounded-full text-white shadow-lg transform translate-y-20 opacity-0 transition-all duration-300 hover:scale-110 hover:shadow-xl focus:outline-none"
  style={`background-color: ${siteConfig.accentColor}`}
  aria-label="Scroll to top"
>
  <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7" />
  </svg>
</button>

<script>
  const backToTopBtn = document.getElementById("back-to-top");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 500) {
      backToTopBtn?.classList.remove("translate-y-20", "opacity-0");
    } else {
      backToTopBtn?.classList.add("translate-y-20", "opacity-0");
    }
  });

  backToTopBtn?.addEventListener("click", () => {
    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });
  });
</script>
