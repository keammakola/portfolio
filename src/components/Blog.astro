---
import { getHashnodePosts } from "../utils/hashnode";

const posts = await getHashnodePosts();
---

<section id="blog" class="px-6 sm:px-12 lg:px-24 py-12 md:py-16 animate-fade-in">
  <div class="mb-8">
    <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Blog Posts</h2>
    <p class="mt-4 text-lg text-gray-600">Thoughts, tutorials, and insights on software development.</p>
  </div>

  {posts.length === 0 && (
    <p class="text-gray-600">Read the latest articles on <a href="https://keammakola.hashnode.dev" class="text-blue-600 hover:underline">my blog &rarr;</a></p>
  )}
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {posts.map((post: any, index: number) => (
      <div 
        class="blog-card group cursor-pointer flex flex-col justify-between overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 shadow-sm hover:shadow-md transition-all hover:border-gray-300"
        data-index={index}
      >
        <div>
          <div class="flex items-center gap-x-4 text-xs">
            <time datetime={post.publishedAt} class="text-gray-500">
              {new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
            <span class="text-gray-500">{post.readTimeInMinutes} min read</span>
          </div>
          <h3 class="mt-3 text-lg font-semibold leading-6 text-gray-900 group-hover:text-blue-600 transition-colors">
            {post.title}
          </h3>
          <p class="mt-3 line-clamp-3 text-sm leading-6 text-gray-600">
            {post.brief}
          </p>
        </div>
        <div class="mt-6 flex items-center gap-x-2 text-sm font-semibold text-blue-600">
          Read article <span aria-hidden="true">&rarr;</span>
        </div>
        
        <!-- Hidden content templates for the modal -->
        <template class="blog-content-template">
          <div set:html={post.content} />
        </template>
        <template class="blog-title-template">{post.title}</template>
        <template class="blog-date-template">{new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</template>
      </div>
    ))}
  </div>
</section>

<!-- Blog Modal -->
<div id="blog-modal" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/60 backdrop-blur-sm transition-opacity duration-300 opacity-0 px-4 py-6 sm:px-6 md:p-12">
  <div id="blog-modal-inner" class="relative w-full max-w-4xl h-full bg-white rounded-2xl shadow-2xl flex flex-col transform scale-95 transition-transform duration-300">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-end px-4 py-3 sm:px-6 sm:py-4 border-b border-gray-100 bg-white rounded-t-2xl z-10 shrink-0">
      <button id="close-blog-modal" class="p-1.5 sm:p-2 text-gray-500 hover:text-gray-800 hover:bg-gray-100 rounded-full transition-colors" aria-label="Close">
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Modal Body (Scrollable) -->
    <div class="flex-grow w-full overflow-y-auto rounded-b-2xl bg-white p-6 sm:p-10 relative">
      <div class="max-w-3xl mx-auto">
        <h1 id="blog-modal-title" class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4"></h1>
        <p id="blog-modal-date" class="text-gray-500 mb-8"></p>
        <article id="blog-modal-content" class="prose prose-blue max-w-none prose-img:rounded-xl prose-headings:font-bold prose-a:text-blue-600 hover:prose-a:text-blue-500"></article>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById('blog-modal');
    const closeBtn = document.getElementById('close-blog-modal');
    const innerModal = document.getElementById('blog-modal-inner');
    const cards = document.querySelectorAll('.blog-card');
    
    const modalTitle = document.getElementById('blog-modal-title');
    const modalDate = document.getElementById('blog-modal-date');
    const modalContent = document.getElementById('blog-modal-content');

    const openModal = () => {
      modal?.classList.remove('hidden');
      setTimeout(() => {
        modal?.classList.remove('opacity-0');
        innerModal?.classList.remove('scale-95');
        innerModal?.classList.add('scale-100');
      }, 10);
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      modal?.classList.add('opacity-0');
      innerModal?.classList.remove('scale-100');
      innerModal?.classList.add('scale-95');
      setTimeout(() => {
        modal?.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
    };

    cards.forEach(card => {
      card.addEventListener('click', () => {
        const titleHtml = card.querySelector('.blog-title-template')?.innerHTML || '';
        const dateHtml = card.querySelector('.blog-date-template')?.innerHTML || '';
        const contentHtml = card.querySelector('.blog-content-template')?.innerHTML || '';
        
        if (modalTitle) modalTitle.innerHTML = titleHtml;
        if (modalDate) modalDate.innerHTML = dateHtml;
        if (modalContent) modalContent.innerHTML = contentHtml;
        
        openModal();
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });
    
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
        closeModal();
      }
    });
  });
</script>
