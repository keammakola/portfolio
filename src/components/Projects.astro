---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="px-6 sm:px-12 lg:px-24 py-12 md:py-16">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 break-words">Projects</h2>
        <div class="w-[75px] h-[5px] mt-2 rounded-full" style={`background-color: ${siteConfig.accentColor}`} />

        <div class="mt-8 space-y-8">
          {siteConfig.projects.map((project, index) => {
            const linkProps = project.link
              ? { href: project.link, target: "_blank", rel: "noopener noreferrer" }
              : {};

            return (
              <div class="group relative">
                <div
                  class={`block relative p-4 sm:p-6 md:p-8 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 ${
                    project.link ? "hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1" : ""
                  }`}
                >
                  {project.link && (
                    <div class="absolute top-4 right-4 sm:top-6 sm:right-6 md:top-8 md:right-8 w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 group-hover:bg-gray-700">
                      <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5 md:w-5 md:h-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
                      </svg>
                    </div>
                  )}

                  <div class="space-y-4">
                    <div>
                      <span class="text-sm font-mono" style={{ color: siteConfig.accentColor }}>
                        0{index + 1}
                      </span>
                      <div class="flex flex-wrap items-center gap-3 mt-1">
                        <h3 class="text-xl sm:text-2xl font-bold text-gray-900 break-words">
                          {project.link ? (
                            <a {...linkProps} class="after:absolute after:inset-0 after:rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-700">{project.name}</a>
                          ) : project.name}
                        </h3>
                        {(("statuses" in project ? project.statuses : undefined) ?? (project.status ? [project.status] : [])).map((status) => (
                          <span class={`px-2 py-0.5 text-xs font-semibold rounded-full ${
                            status === 'Live' ? 'bg-green-100 text-green-800' :
                            status === 'In Development' ? 'bg-amber-100 text-amber-800' :
                            'bg-purple-100 text-purple-800'
                          }`}>
                            {status}
                          </span>
                        ))}
                      </div>
                    </div>

                    <p class={`text-base sm:text-lg text-gray-600 leading-relaxed ${project.link ? "pr-12 sm:pr-14 md:pr-16" : ""}`}>
                      {project.description}
                    </p>

                    {project.skills && project.skills.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                        {project.skills.map((skill) => {
                          const choice = "techChoices" in project
                            ? project.techChoices?.find((choice) => choice.technologies.includes(skill))
                            : undefined;
                          const pillClass = "px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-900 text-white rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-colors duration-300";
                          return choice ? (
                            <button
                              type="button"
                              class={`${pillClass} relative z-10 cursor-pointer hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700`}
                              data-tech-name={skill}
                              data-tech-project={project.name}
                              data-tech-role={choice.role}
                              data-tech-reason={choice.reason}
                              aria-haspopup="dialog"
                              aria-controls="tech-choice-modal"
                              aria-label={`Why I chose ${skill} for ${project.name}`}
                            >
                              {skill}
                            </button>
                          ) : <span class={pillClass}>{skill}</span>;
                        })}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )
}

<dialog id="tech-choice-modal" aria-labelledby="tech-choice-title" aria-describedby="tech-choice-reason" class="m-auto w-[calc(100%-2rem)] max-w-lg max-h-[85vh] overflow-y-auto rounded-2xl bg-white p-6 sm:p-8 text-gray-900 shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p id="tech-choice-project" class="text-xs font-medium text-gray-500 mb-2"></p>
      <h2 id="tech-choice-title" class="text-2xl font-bold"></h2>
    </div>
    <form method="dialog">
      <button type="submit" aria-label="Close technology details" class="flex size-10 items-center justify-center rounded-full text-gray-500 hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-blue-700" autofocus>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg>
      </button>
    </form>
  </div>
  <h3 class="mt-6 mb-2 text-sm font-semibold">What it does</h3>
  <p id="tech-choice-role" class="text-gray-600 leading-relaxed"></p>
  <h3 class="mt-6 mb-2 text-sm font-semibold">Why I chose it</h3>
  <p id="tech-choice-reason" class="text-gray-600 leading-relaxed"></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#tech-choice-modal");
  let trigger: HTMLButtonElement | null = null;
  let previousOverflow = "";

  document.querySelectorAll<HTMLButtonElement>("[data-tech-name]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!dialog || dialog.open) return;
      const fields = {
        "tech-choice-title": button.dataset.techName,
        "tech-choice-project": button.dataset.techProject,
        "tech-choice-role": button.dataset.techRole,
        "tech-choice-reason": button.dataset.techReason,
      };
      Object.entries(fields).forEach(([id, value]) => {
        const element = document.getElementById(id);
        if (element) element.textContent = value ?? "";
      });
      trigger = button;
      previousOverflow = document.body.style.overflow;
      dialog.showModal();
      document.body.style.overflow = "hidden";
    });
  });

  dialog?.addEventListener("click", (event) => {
    if (event.target !== dialog) return;
    const bounds = dialog.getBoundingClientRect();
    if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
  });
  dialog?.addEventListener("close", () => {
    document.body.style.overflow = previousOverflow;
    trigger?.focus();
  });
</script>
