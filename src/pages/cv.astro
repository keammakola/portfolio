---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={`CV for ${siteConfig.name}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>CV - {siteConfig.name}</title>
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-grow pt-24 pb-12 flex flex-col items-center">
      <div class="w-full max-w-5xl px-4 flex flex-col h-[85vh]">
        <div class="flex justify-between items-center mb-6">
          <h1 class="text-3xl font-bold text-gray-900">Curriculum Vitae</h1>
          <a
            href="/Keabetswe_Mmakola_CV.pdf"
            download
            class="inline-flex items-center gap-x-2 rounded-full bg-gray-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-gray-800 transition-colors"
          >
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 3a.75.75 0 01.75.75v10.638l3.96-4.158a.75.75 0 111.08 1.04l-5.25 5.5a.75.75 0 01-1.08 0l-5.25-5.5a.75.75 0 111.08-1.04l3.96 4.158V3.75A.75.75 0 0110 3z" clip-rule="evenodd" />
            </svg>
            Download PDF
          </a>
        </div>
        <div class="w-full flex-grow border border-gray-200 rounded-xl overflow-hidden shadow-sm bg-gray-50 relative">
          <object 
            data="/Keabetswe_Mmakola_CV.pdf" 
            type="application/pdf" 
            class="absolute inset-0 w-full h-full"
          >
            <div class="flex flex-col items-center justify-center h-full p-8 text-center bg-white absolute inset-0">
              <p class="text-gray-600 mb-4">Your browser doesn't support built-in PDF viewing.</p>
              <a 
                href="/Keabetswe_Mmakola_CV.pdf" 
                download
                class="inline-flex items-center gap-x-2 rounded-md bg-[var(--accent-color)] px-4 py-2 text-sm font-semibold text-white hover:opacity-90 transition-opacity"
                style={`--accent-color: ${siteConfig.accentColor}`}
              >
                Download PDF
              </a>
            </div>
          </object>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
